# ── Auth (NextAuth + Google) ────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Database (Firestore via firebase-admin; server only) ────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON as-is, or base64-encode it (base64 -w0 key.json).
FIREBASE_SERVICE_ACCOUNT_KEY=
# …or provide the three fields separately:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# ── Web push (optional) ─────────────────────────────────────────────────────
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com

# ── Local demo (development only, ignored in production builds) ─────────────
# Runs on an in-memory seeded store with one-click sign-in. No Google or Firebase needed.
# COOKED_E2E=1
# NEXT_PUBLIC_COOKED_E2E=1
